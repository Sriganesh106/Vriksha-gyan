# ==============================================================================
# Vriksha Gyan - Environment Variables Template
# Copy this file to .env and fill in your API keys
# ==============================================================================

# Google Places API Key (Used in /api/places/search and /api/places/details)
GOOGLE_PLACES_API_KEY=

# Foursquare Places API Key (Used in /api/foursquare/search and /api/foursquare/details)
FOURSQUARE_API_KEY=

# Google Gemini API Key (Used for Gemini Chatbot & RAG Embeddings)
GEMINI_API_KEY=

# ==============================================================================
# Supabase Configuration (Vector Database / pgvector for RAG)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
