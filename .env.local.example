# Firebase Configuration
# IMPORTANT: Replace these with your actual Firebase project credentials
# Get these from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=your-actual-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Foursquare Places API Configuration
# FREE: 50,000 calls/day, no credit card required
# Get your API key from: https://foursquare.com/developers
FOURSQUARE_API_KEY=your-foursquare-api-key-here

# Google Places API Configuration (Alternative - requires billing)
# Get your API key from: https://console.cloud.google.com
# GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# STEP-BY-STEP INSTRUCTIONS:
# 1. Go to https://console.firebase.google.com
# 2. Create a new project (or select existing one)
# 3. Go to Project Settings → General → Your apps
# 4. Add a web app if you haven't already
# 5. Copy the config values from the Firebase SDK snippet
# 6. Go to Build → Realtime Database → Create Database
# 7. Choose "Start in test mode" for development
# 8. Copy this file to .env.local and replace the values
# 9. Restart your development server: npm run dev

# Example of what the URL should look like:
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://my-project-12345-default-rtdb.firebaseio.com/
# OR for other regions:
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://my-project-12345-default-rtdb.asia-southeast1.firebasedatabase.app/
